<Project Sdk="Microsoft.NET.Sdk">

  <!-- SPDX-License-Identifier: GPL-2.0-or-later -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12.0</LangVersion>
    <Platforms>x64</Platforms>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- LibraryImport source generation, not DllImport. It produces the
         marshalling code at compile time, which is required for AOT and, more
         usefully here, means the marshalling is inspectable rather than
         generated by the runtime at first call. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

</Project>
