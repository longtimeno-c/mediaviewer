<Project Sdk="Microsoft.NET.Sdk">

  <!-- SPDX-License-Identifier: GPL-2.0-or-later -->
  <!-- Milestone G (plan/18): the Import add-on's Windows chrome. Shipped in the
       signed add-on archive beside mv_import.dll, never in the base install.
       Loaded by IslandHost.Addons.cs into its own collectible
       AssemblyLoadContext; MediaViewer.Interop (IAddonHost, ImportApi) and the
       Windows App SDK come from the host, so neither is copied here. The UI is
       built in code: no XAML compile step, so nothing here needs the XAML
       compiler at the add-on's own build. -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12.0</LangVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>false</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <WindowsAppSdkBootstrapInitialize>false</WindowsAppSdkBootstrapInitialize>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>MediaViewer.Import.Chrome</RootNamespace>
    <AssemblyName>MediaViewer.Import.Chrome</AssemblyName>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4948" />
    <!-- Compile against the host's WinUI; the host process already has it loaded. -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" ExcludeAssets="runtime;native" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MediaViewer.Interop\MediaViewer.Interop.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
  </ItemGroup>

</Project>
