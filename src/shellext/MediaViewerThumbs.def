; PR 15: the Explorer thumbnail handler's COM entry points. Registration is
; the app's (shell/shellext_install.cpp), not DllRegisterServer: a per-user
; install writes HKCU keys itself and never needs regsvr32.
LIBRARY MediaViewerThumbs
EXPORTS
  DllGetClassObject PRIVATE
  DllCanUnloadNow PRIVATE
