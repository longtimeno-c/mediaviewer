<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The Network Extension capability (packet-tunnel-provider; Developer ID:
     "-systemextension") is ticked on the extension's App ID by the team, and macOS
     loads the extension only with that App ID's Developer ID provisioning profile
     embedded (macpack.py release, its tunnel profile option; RELEASING.md). Without the
     profiles the extension is not built (MV_DRIFTWIRE_PACKET_TUNNEL=OFF). -->
<plist version="1.0">
<dict>
  <key>com.apple.developer.networking.networkextension</key>
  <array>
    <string>packet-tunnel-provider-systemextension</string>
  </array>
  <key>com.apple.security.app-sandbox</key>
  <true/>
  <key>com.apple.security.network.client</key>
  <true/>
  <key>com.apple.security.network.server</key>
  <true/>
</dict>
</plist>
