//
// PR 8 identity: the app mark as icon resource 1 (Explorer, shortcuts, the
// window class) and VERSIONINFO from the single version source — CMake's
// project(VERSION), passed in as MV_VER_* / MV_APP_VERSION_STR.
// assets/icon/mediaviewer.ico is generated by tools/make-icon.py.

#include <winres.h>

#include "shell/app_icon.h"

// MV_ICON_FILE is an absolute path from CMake: rc.exe resolves a relative one
// against the build directory, not this file.
MV_IDI_APP ICON MV_ICON_FILE

VS_VERSION_INFO VERSIONINFO
 FILEVERSION MV_VER_MAJOR, MV_VER_MINOR, MV_VER_PATCH, 0
 PRODUCTVERSION MV_VER_MAJOR, MV_VER_MINOR, MV_VER_PATCH, 0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "longtimeno-c"
      VALUE "FileDescription", "MediaViewer"
      VALUE "FileVersion", MV_APP_VERSION_STR
      VALUE "InternalName", "MediaViewer"
      VALUE "LegalCopyright", "Copyright (C) 2026 longtimeno-c. Licensed under GPL-3.0-or-later. https://github.com/longtimeno-c/mediaviewer"
      VALUE "OriginalFilename", "MediaViewer.exe"
      VALUE "ProductName", "MediaViewer"
      VALUE "ProductVersion", MV_APP_VERSION_STR
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
