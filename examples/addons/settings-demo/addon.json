{
  "id": "example.settings-demo",
  "name": "Settings Demo",
  "version": "1.0.0",
  "description": "Every kind of setting an add-on's page can have, and a compact theme.",
  "licence": "MIT",
  "publisher": { "name": "Example Publisher", "url": "" },
  "update_url": "",
  "api": { "min": 2, "max": 2 },
  "contributes": {
    "themes": [
      { "id": "compact", "name": "Compact Dusk", "path": "themes/compact.json" }
    ],
    "settings": {
      "title": "Places",
      "sections": [
        {
          "title": "Place",
          "help": "How a photo's place is named.",
          "items": [
            { "type": "toggle", "key": "show_map", "label": "Show the map", "default": true },
            { "type": "toggle", "key": "show_town", "label": "Name the town", "default": true },
            { "type": "number", "key": "town_radius_km", "label": "Town radius",
              "min": 1, "max": 50, "step": 1, "unit": "km", "default": 15,
              "help": "Name the nearest town within this distance.",
              "enabled_by": "show_town" },
            { "type": "choice", "key": "label_names", "label": "Place names",
              "options": [
                { "value": "english", "label": "English" },
                { "value": "local", "label": "Local" }
              ],
              "default": "english" }
          ]
        },
        {
          "title": "Home",
          "items": [
            { "type": "text", "key": "home", "label": "Home town", "max_length": 64,
              "placeholder": "Lisbon", "default": "" }
          ]
        }
      ]
    }
  }
}
