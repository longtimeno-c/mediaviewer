<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Copyright (C) 2026 longtimeno-c
  SPDX-License-Identifier: GPL-3.0-or-later
  MediaViewerSpotlight.mdimporter (PR 15, plan/12 2026-09-25): Spotlight
  fields for the D5 clip containers macOS does not index itself (Matroska,
  WebM, AVI, MPEG-TS). Stills are not claimed: the system Image importer
  already indexes every D5 still type, RAW included. Runs in mdworker, never
  in Finder; it goes with the app when the app is dragged to the Trash.
-->
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleExecutable</key>
  <string>MediaViewerSpotlight</string>
  <key>CFBundleIdentifier</key>
  <string>@MV_MAC_BUNDLE_ID@.spotlight</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundleName</key>
  <string>MediaViewer Spotlight</string>
  <key>CFBundlePackageType</key>
  <string>BNDL</string>
  <key>CFBundleShortVersionString</key>
  <string>@PROJECT_VERSION@</string>
  <key>CFBundleVersion</key>
  <string>@MV_MAC_BUILD_NUMBER@</string>
  <key>LSMinimumSystemVersion</key>
  <string>14.0</string>
  <key>CFBundleDocumentTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeRole</key>
      <string>MDImporter</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>org.matroska.mkv</string>
        <string>org.webmproject.webm</string>
        <string>public.avi</string>
        <string>public.mpeg-2-transport-stream</string>
      </array>
    </dict>
  </array>
  <key>CFPlugInDynamicRegistration</key>
  <string>NO</string>
  <key>CFPlugInFactories</key>
  <dict>
    <key>5C0E7B2A-94D1-4F63-A8E5-2B7C1D9F0E46</key>
    <string>MetadataImporterPluginFactory</string>
  </dict>
  <key>CFPlugInTypes</key>
  <dict>
    <key>8B08C4BF-415B-11D8-B3F9-0003936726FC</key>
    <array>
      <string>5C0E7B2A-94D1-4F63-A8E5-2B7C1D9F0E46</string>
    </array>
  </dict>
  <key>CFPlugInUnloadFunction</key>
  <string></string>
</dict>
</plist>
