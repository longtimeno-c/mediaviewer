<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Copyright (C) 2026 longtimeno-c
  SPDX-License-Identifier: GPL-3.0-or-later
  DEVELOPER BUILDS ONLY (MV_ADDON_DEV_PUBLIC_KEY set): a locally built AI pack
  is not signed by the team, so library validation would refuse it in the
  agent. tools/mac/macpack.py assemble uses this only for a dev-key build and a
  release build signs the agent with no entitlements at all (library
  validation on: only the team's own pack loads).
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
