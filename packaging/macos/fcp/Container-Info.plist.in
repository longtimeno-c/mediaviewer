<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Copyright (C) 2026 longtimeno-c
  SPDX-License-Identifier: GPL-3.0-or-later
  MediaViewer for Final Cut Pro.app (plan/23): the "fcp" add-on's container.
  It holds the workflow extension (Contents/PlugIns) and the Local search
  agent (Contents/MacOS, registered from Contents/Library/LaunchAgents).
-->
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleExecutable</key>
  <string>MediaViewer for Final Cut Pro</string>
  <key>CFBundleIdentifier</key>
  <string>@MV_FCP_BUNDLE_ID@</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundleName</key>
  <string>MediaViewer for Final Cut Pro</string>
  <key>CFBundleDisplayName</key>
  <string>MediaViewer for Final Cut Pro</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleShortVersionString</key>
  <string>@MV_FCP_VERSION@</string>
  <key>CFBundleVersion</key>
  <string>@MV_FCP_VERSION@</string>
  <key>LSMinimumSystemVersion</key>
  <string>14.0</string>
  <key>LSApplicationCategoryType</key>
  <string>public.app-category.video</string>
  <key>NSHighResolutionCapable</key>
  <true/>
  <key>NSPrincipalClass</key>
  <string>NSApplication</string>
</dict>
</plist>
