<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Copyright (C) 2026 longtimeno-c
  SPDX-License-Identifier: GPL-3.0-or-later
  MediaViewer Search.app: the Final Cut Pro add-on's container for its workflow
  extension (docs/design/23, 2026-10-19). macOS lists an extension only from an
  app bundle LaunchServices has registered (a bare .appex given to pluginkit
  is never discovered), so the add-on carries this one. The user never
  installs or opens it: MediaViewer registers it when Final Cut Pro is turned
  on in Settings > Local search, and unregisters it when turned off.
-->
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleExecutable</key>
  <string>MediaViewerSearchHost</string>
  <key>CFBundleIdentifier</key>
  <string>@MV_MAC_BUNDLE_ID@.finalcut-host</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundleName</key>
  <string>MediaViewer Search</string>
  <key>CFBundleDisplayName</key>
  <string>MediaViewer Search</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleShortVersionString</key>
  <string>@MV_FCP_VERSION@</string>
  <key>CFBundleVersion</key>
  <string>@MV_MAC_BUILD_NUMBER@</string>
  <key>LSMinimumSystemVersion</key>
  <string>14.0</string>
  <key>LSBackgroundOnly</key>
  <true/>
  <key>LSUIElement</key>
  <true/>
</dict>
</plist>
