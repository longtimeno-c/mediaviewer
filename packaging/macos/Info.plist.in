<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Copyright (C) 2026 longtimeno-c
  SPDX-License-Identifier: GPL-3.0-or-later
  MediaViewer.app (PR 20, docs/design/15). Configured by cmake/darwin.cmake.

  Document types are the D5 still set plus the D5 video containers, at
  LSHandlerRank Alternate: MediaViewer appears in Finder's "Open With" and
  never becomes the default on its own. Becoming the default is an in-app
  prompt, once, after the first still opens (docs/design/13); it reads this list, so
  video is offered with the stills. QuickLook-Info.plist.in lists the still
  types; tools/mac/check_plists.py fails if the two drift or a D5 still
  format goes missing.
-->
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleExecutable</key>
  <string>MediaViewer</string>
  <key>CFBundleIconFile</key>
  <string>MediaViewer</string>
  <key>CFBundleIdentifier</key>
  <string>@MV_MAC_BUNDLE_ID@</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundleName</key>
  <string>MediaViewer</string>
  <key>CFBundleDisplayName</key>
  <string>MediaViewer</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleShortVersionString</key>
  <string>@PROJECT_VERSION@</string>
  <key>CFBundleVersion</key>
  <string>@MV_MAC_BUILD_NUMBER@</string>
  <key>LSMinimumSystemVersion</key>
  <string>14.0</string>
  <key>LSArchitecturePriority</key>
  <array>
    <string>arm64</string>
    <string>x86_64</string>
  </array>
  <key>LSApplicationCategoryType</key>
  <string>public.app-category.photography</string>
  <key>NSPrincipalClass</key>
  <string>NSApplication</string>
  <key>NSHighResolutionCapable</key>
  <true/>
  <key>NSSupportsAutomaticGraphicsSwitching</key>
  <true/>
  <!-- Local search's Photos library source (issue #72): the system prompt
       shows this once, from a click in Settings. Read-only, on this Mac only. -->
  <key>NSPhotoLibraryUsageDescription</key>
  <string>Local search can find photos and videos in your Photos library by what they show. It reads only what is already on this Mac, never changes your library, and sends nothing anywhere.</string>
  <!-- Cmd+E on a Photos library item (docs/design/26): the Automation prompt
       shows this once, the first time MediaViewer asks Photos to show a photo. -->
  <key>NSAppleEventsUsageDescription</key>
  <string>MediaViewer asks Photos to show the photo or video you are viewing when you choose Show in Photos. It sends nothing else to Photos.</string>
  <key>NSHumanReadableCopyright</key>
  <string>Copyright (C) 2026 longtimeno-c. Licensed under GPL-3.0-or-later. https://github.com/longtimeno-c/mediaviewer</string>

  <key>CFBundleDocumentTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeName</key>
      <string>Image</string>
      <key>CFBundleTypeRole</key>
      <string>Viewer</string>
      <key>LSHandlerRank</key>
      <string>Alternate</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>public.jpeg</string>
        <string>public.png</string>
        <string>com.microsoft.bmp</string>
        <string>com.compuserve.gif</string>
        <string>public.tiff</string>
        <string>org.webmproject.webp</string>
        <string>public.heic</string>
        <string>public.heif</string>
        <string>public.avif</string>
        <string>com.microsoft.ico</string>
        <string>public.camera-raw-image</string>
      </array>
    </dict>
    <dict>
      <key>CFBundleTypeName</key>
      <string>Video</string>
      <key>CFBundleTypeRole</key>
      <string>Viewer</string>
      <key>LSHandlerRank</key>
      <string>Alternate</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>public.mpeg-4</string>
        <string>com.apple.m4v-video</string>
        <string>com.apple.quicktime-movie</string>
        <string>org.matroska.mkv</string>
        <string>org.webmproject.webm</string>
        <string>public.avi</string>
        <string>public.mpeg-2-transport-stream</string>
      </array>
    </dict>
    <!-- Audio: in Finder's Open With, never made the default — not by the
         first-launch offer, not by adopting new types (owner, 2026-10-03). -->
    <dict>
      <key>CFBundleTypeName</key>
      <string>Audio</string>
      <key>CFBundleTypeRole</key>
      <string>Viewer</string>
      <key>LSHandlerRank</key>
      <string>Alternate</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>public.mp3</string>
        <string>com.apple.m4a-audio</string>
        <string>com.apple.protected-mpeg-4-audio</string>
      </array>
    </dict>
    <!-- Documents: Open With only, like Audio above. -->
    <dict>
      <key>CFBundleTypeName</key>
      <string>Document</string>
      <key>CFBundleTypeRole</key>
      <string>Viewer</string>
      <key>LSHandlerRank</key>
      <string>Alternate</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>com.adobe.pdf</string>
        <string>org.openxmlformats.wordprocessingml.document</string>
      </array>
    </dict>
  </array>

  <!-- macOS 14 declares every type above except AVIF, Matroska and WebM,
       which are imported so a .avif/.mkv/.webm never lacks a type. An
       imported declaration yields to the system's own. -->
  <key>UTImportedTypeDeclarations</key>
  <array>
    <dict>
      <key>UTTypeIdentifier</key>
      <string>public.avif</string>
      <key>UTTypeDescription</key>
      <string>AVIF image</string>
      <key>UTTypeConformsTo</key>
      <array>
        <string>public.image</string>
      </array>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array>
          <string>avif</string>
        </array>
        <key>public.mime-type</key>
        <array>
          <string>image/avif</string>
        </array>
      </dict>
    </dict>
    <dict>
      <key>UTTypeIdentifier</key>
      <string>org.matroska.mkv</string>
      <key>UTTypeDescription</key>
      <string>Matroska video</string>
      <key>UTTypeConformsTo</key>
      <array>
        <string>public.movie</string>
      </array>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array>
          <string>mkv</string>
        </array>
        <key>public.mime-type</key>
        <array>
          <string>video/x-matroska</string>
        </array>
      </dict>
    </dict>
    <dict>
      <key>UTTypeIdentifier</key>
      <string>org.webmproject.webm</string>
      <key>UTTypeDescription</key>
      <string>WebM video</string>
      <key>UTTypeConformsTo</key>
      <array>
        <string>public.movie</string>
      </array>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array>
          <string>webm</string>
        </array>
        <key>public.mime-type</key>
        <array>
          <string>video/webm</string>
        </array>
      </dict>
    </dict>
  </array>
@MV_SPARKLE_PLIST_KEYS@
</dict>
</plist>
