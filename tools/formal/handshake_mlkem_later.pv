(* Driftwire protocol 2, the first link (XXhfs): "harvest now, decrypt later".
   Phase 0: honest runs of the first link; the attacker owns the network
   (stronger than only recording it: the code check is what keeps it out of the
   middle, handshake_code.pv). Phase 1: ML-KEM-768 is broken (every run's ML-KEM secret key is handed over).
   Expected: both true: X25519 still protects the recording. *)

free file, probe: bitstring [private].

query attacker(file) phase 1.    (* the files sent after the code *)
query attacker(probe) phase 1.   (* the resume secret *)

process
  new sc: bitstring; new ss: bitstring;
  out(c, (exp(g, sc), exp(g, ss)));
  !( new screen: channel;
     ( XXClient(c, c, screen, sc, false, true, file, probe)
     | XXServer(c, c, screen, ss, false, true) ) )
