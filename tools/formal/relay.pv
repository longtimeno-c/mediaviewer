(* The hop to a relay server of the person's own (protocol 3, #500), as a
   forwarder uses it: the Tunnel (2026-11-12, docs/plans/driftwire-menu-and-tunnel.md).
   src/addons/driftwire/splice.cpp, `forward` and `server::handle`:

     C -> S  "MVRL" 3 kForwarder 0 0, sid, Ya = gen(key, sid)^ya   (CPace on the server key)
     S -> C  Yb
     then Noise_NNpsk0, the server first, psk = ISK, everything above in the prologue:
     S -> C  psk, e                (empty payload)
     C -> S  e, ee                 (payload: the port and host to forward to)
     S -> C  its word, sealed      (kForwarding, or why not)
     then the stream, sealed both ways under the split keys.

   A waiter's registration is the same handshake with its token as the
   payload (its own CPace channel name, its own role in the prologue); the
   checks below carry over to it.

   The attacker owns the network and runs any number of sessions with the
   client and the server, all under the same key. As in driftwire.pvl, the
   handshake ciphertexts carry a constant associated data instead of h (only
   helps the attacker), and the stream is one AEAD per frame.

   Expected: every query true. *)

free key: bitstring [private].
free host: bitstring [private].   (* the site a person asks for *)
free dataC, dataS: bitstring [private].

const NAME_NNPSK0: bitstring.      (* "Noise_NNpsk0_25519_ChaChaPoly_BLAKE2b" *)
const PROLOGUE_RELAY: bitstring.   (* "MediaViewer Driftwire relay 3", the head (kForwarder) *)
const AD_RELAY: bitstring.
const FORWARDING: bitstring.       (* kForwarding *)

event ClientAsks(bitstring).        (* a key holder sent this request *)
event ServerForwards(bitstring).    (* the server opened this request and connects onward *)
event ClientForwarding(bitstring).  (* the client heard kForwarding for this request *)

(* The key resists offline guessing from any number of transcripts and live
   runs: a short typed key is guessed one per connection at most. *)
weaksecret key.
(* Which site a person visits, and what goes either way, never reach the network. *)
query attacker(host).
query attacker(dataC).
query attacker(dataS).
(* Never for anyone without the key: whatever the server forwards, a key
   holder asked for. Not an open proxy. *)
query r: bitstring; event(ServerForwards(r)) ==> event(ClientAsks(r)).
(* A client that hears "forwarding" heard it from the server holding the key,
   about its own request. *)
query r: bitstring; event(ClientForwarding(r)) ==> event(ServerForwards(r)).

let Client(k: bitstring, req: bitstring, data: bitstring) =
  new sid: bitstring; new ya: bitstring;
  let bya = exp(gen(k, sid), ya) in
  out(c, (sid, bya));
  in(c, byb: bitstring);
  let psk = isk(sid, exp(byb, ya), bya, byb) in
  let h0 = NAME_NNPSK0 in
  let ck0 = h0 in
  let hp = hash(h0, (PROLOGUE_RELAY, sid, bya, byb)) in
  let ck1 = hkdf1(ck0, psk) in
  (* <- psk, e *)
  in(c, (re: bitstring, p1_enc: bitstring));
  let ck2 = hkdf1(ck1, re) in let k2 = hkdf2(ck1, re) in
  if aead_open(k2, n0, AD_RELAY, p1_enc) = empty then
  (* -> e, ee, the request *)
  new e: bitstring;
  let epub = exp(g, e) in
  let ck3 = hkdf1(ck2, epub) in
  let ck4 = hkdf1(ck3, exp(re, e)) in let k4 = hkdf2(ck3, exp(re, e)) in
  event ClientAsks(req);
  out(c, (epub, aead(k4, n0, AD_RELAY, req)));
  let ki2r = hkdf1(ck4, empty) in let kr2i = hkdf2(ck4, empty) in
  in(c, w: bitstring);
  if aead_open(ki2r, n0, empty, w) = FORWARDING then
  event ClientForwarding(req);
  out(c, aead(kr2i, n0, empty, data));
  in(c, back: bitstring);
  let got = aead_open(ki2r, n1, empty, back) in 0.

let Server(k: bitstring, data: bitstring) =
  in(c, (sid: bitstring, bya: bitstring));
  new yb: bitstring;
  let byb = exp(gen(k, sid), yb) in
  out(c, byb);
  let psk = isk(sid, exp(bya, yb), bya, byb) in
  let h0 = NAME_NNPSK0 in
  let ck0 = h0 in
  let hp = hash(h0, (PROLOGUE_RELAY, sid, bya, byb)) in
  let ck1 = hkdf1(ck0, psk) in
  new e: bitstring;
  let epub = exp(g, e) in
  let ck2 = hkdf1(ck1, epub) in let k2 = hkdf2(ck1, epub) in
  out(c, (epub, aead(k2, n0, AD_RELAY, empty)));
  in(c, (re: bitstring, req_enc: bitstring));
  let ck3 = hkdf1(ck2, re) in
  let ck4 = hkdf1(ck3, exp(re, e)) in let k4 = hkdf2(ck3, exp(re, e)) in
  let req = aead_open(k4, n0, AD_RELAY, req_enc) in
  let ki2r = hkdf1(ck4, empty) in let kr2i = hkdf2(ck4, empty) in
  event ServerForwards(req);
  out(c, aead(ki2r, n0, empty, FORWARDING));
  in(c, sent: bitstring);
  let got = aead_open(kr2i, n0, empty, sent) in
  out(c, aead(ki2r, n1, empty, data)).

process
  ( !Client(key, host, dataC)
  | !Server(key, dataS) )
