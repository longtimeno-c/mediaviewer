<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Without this an iPhone holds the app to 60 Hz. -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- One window for 1.0: the app has one model of what is on screen. -->
	<!-- The first copy, kept going after the person leaves the app on iOS 26 (docs/plans/mobile.md 8.4). -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>io.github.longtimeno-c.mediaviewer.mobile.first-copy</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
</dict>
</plist>
