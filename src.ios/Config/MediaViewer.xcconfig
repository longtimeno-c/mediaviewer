// The MediaViewer app's identity, version and signing. Raise CURRENT_PROJECT_VERSION for every
// TestFlight upload and MARKETING_VERSION for every release.
//
// Signing: set DEVELOPMENT_TEAM in Config/Signing.local.xcconfig (not in git), for example
//   DEVELOPMENT_TEAM = ABCDE12345
// Without it the app still builds for the Simulator (signed to run locally), and a device archive
// needs CODE_SIGNING_ALLOWED=NO on the xcodebuild line (docs/DEVELOPMENT.md).

PRODUCT_BUNDLE_IDENTIFIER = io.github.longtimeno-c.mediaviewer.mobile
MARKETING_VERSION = 1.0
CURRENT_PROJECT_VERSION = 1

ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
INFOPLIST_KEY_LSApplicationCategoryType = public.app-category.photography

CODE_SIGN_STYLE = Automatic
DEVELOPMENT_TEAM =
#include? "Signing.local.xcconfig"
